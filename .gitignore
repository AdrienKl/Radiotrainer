# Cartes OACI sources (~178 Mo) : elles servent à FABRIQUER les tuiles de assets/oaci/,
# elles n'ont pas à être publiées. À conserver localement : sans elles, impossible de
# régénérer les tuiles (par exemple pour ajouter le zoom 11).
originaux/
500k_*.pdf

# Manuel de référence (2,4 Mo) : il est désormais PUBLIÉ — la page Cours l'intègre
# telle quelle (cours « Manuel de phraséologie (DSNA) »). Il doit donc être versionné.

# macOS
.DS_Store

# Photos d'avion sources (~34 Mo) : elles servent à FABRIQUER les découpes de
# assets/avions/. Ce sont les .webp détourés qui sont publiés, pas les originaux.
photo avion/

# Cartes OACI sources deplacees dans ce dossier : elles servent a fabriquer les
# tuiles de assets/oaci/, elles ne sont pas publiees.
carte oaci/

# Outillage de test (Playwright). Le code des tests est versionné (tests/),
# pas le navigateur qu'il pilote ni les traces qu'il produit.
node_modules/
test-results/
playwright-report/

# Les exports du catalogue de phraseologie : deux vues du JSON, refaites
# en une commande (outils/exporter-catalogue.py). Deux copies d une meme
# donnee finissent toujours par diverger — la source reste le JSON.
Albatros-VFR-phraseologie-DSNA.csv
Albatros-VFR-phraseologie-DSNA.md
